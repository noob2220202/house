{
  "name": "@house/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared zod schemas, enums and constants for api and frontends",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/esm/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@house/config": "workspace:*",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "typescript": "5.9.3"
  }
}
