{
  "name": "@house/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React component library + design tokens (BRAND design system, direction B · Crisp Blue)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen": "node scripts/gen-from-design.mjs && prettier --write \"src/**/*.generated.tsx\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@house/config": "workspace:*",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "31.0.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
