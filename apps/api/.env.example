# ─────────────────────────────────────────────────────────────────────────────
# House API (apps/api) environment. Copy to apps/api/.env for local dev.
# Every variable is validated at boot by src/config/env.schema.ts (zod).
# Never commit real secrets. Generate secrets with:  openssl rand -base64 48
# NOTE: no SMS provider and no Apple sign-in exist (owner decision).
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ---
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=4000
TRUST_PROXY=loopback            # nginx on the same host; or hop count / CIDR list
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
LOG_PRETTY=true                 # false in production (JSON logs)
SWAGGER_ENABLED=true            # /api/v1/docs — must be false in production

# --- URLs / CORS ---
PUBLIC_BASE_URL=http://localhost:3000     # user site (apps/web)
ADMIN_BASE_URL=http://localhost:3001      # back-office (apps/admin)
API_BASE_URL=http://localhost:4000        # public URL of this API (OAuth redirect base)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001   # also used by the CSRF Origin check
BODY_LIMIT=1mb

# --- PostgreSQL 16 + PostGIS 3.4 + pg_trgm ---
DATABASE_URL=postgresql://house:house@localhost:5432/house_dev?schema=public

# --- Redis (sessions, rate limits, cache, BullMQ) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=house:

# --- sessions / cookies ---
COOKIE_SECRET=dev-only-cookie-secret-change-me-0123456789abcdef   # >= 32 chars
COOKIE_DOMAIN=                  # e.g. .example.kr when web/admin/api share a parent domain
COOKIE_SECURE=                  # empty = true in production, false otherwise
SESSION_IDLE_TTL_SECONDS=1209600        # 14 days sliding
SESSION_ABSOLUTE_TTL_SECONDS=7776000    # 90 days max
ADMIN_SESSION_IDLE_TTL_SECONDS=1800     # 30 min sliding
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=43200  # 12 h max
ADMIN_IP_ALLOWLIST=             # optional, comma-separated IPs/CIDRs for /api/v1/admin/*
# base64 of exactly 32 bytes (AES-256-GCM key for admin TOTP secrets): openssl rand -base64 32
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMtbG9uZyE=

# --- social login: 카카오 / 네이버 / Google only ---
# A provider is enabled when its CLIENT_ID is set. Redirect URIs (fixed, registered in consoles):
#   ${API_BASE_URL}/api/v1/auth/oauth/kakao/callback
#   ${API_BASE_URL}/api/v1/auth/oauth/naver/callback
#   ${API_BASE_URL}/api/v1/auth/oauth/google/callback
KAKAO_CLIENT_ID=                # REST API key
KAKAO_CLIENT_SECRET=            # 보안 > Client Secret (if enabled)
KAKAO_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# --- Naver Cloud Maps (geocoding server-side) ---
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- 공공데이터포털 (국토교통부 아파트 매매/전월세 실거래가) ---
DATA_GO_KR_SERVICE_KEY=         # decoded (not URL-encoded) service key

# --- media ---
UPLOAD_DIR=./.data/uploads                  # prod: /var/lib/house/uploads (nginx serves /media/*)
PRIVATE_UPLOAD_DIR=./.data/private-uploads  # prod: /var/lib/house/private (never served by nginx)
MEDIA_BASE_URL=/media
MAX_UPLOAD_MB=15

# --- region ---
REGION_SGG_CODE=46150           # 순천시 시군구 코드 (configurable: admin codes can change)

# --- jobs / rate limits ---
JOBS_ENABLED=true               # register BullMQ repeatable jobs at boot
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300              # default per-IP requests per window

# --- seed only (pnpm db:seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
