// Owned by the agencies module team: 중개사무소, staff, documents, approval history.

enum AgencyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("agency_status")
}

enum AgencyMemberRole {
  OWNER
  AGENT

  @@map("agency_member_role")
}

enum AgencyMemberStatus {
  INVITED
  ACTIVE
  REMOVED

  @@map("agency_member_status")
}

enum AgencyDocumentType {
  REGISTRATION_CERT
  BUSINESS_REG_CERT
  BROKER_LICENSE
  OTHER

  @@map("agency_document_type")
}

/// 사무소 홈페이지 lifecycle (shared twin: AgencySiteStatus).
enum AgencySiteStatus {
  REQUESTED
  ACTIVE
  REJECTED
  SUSPENDED

  @@map("agency_site_status")
}

/// Paid products of an office (shared twin: SubscriptionProduct). Free for now (SPEC O4).
enum SubscriptionProduct {
  SITE
  PLATFORM

  @@map("subscription_product")
}

model Agency {
  id                 String                                 @id @default(uuid(7)) @db.Uuid
  ownerUserId        String                                 @map("owner_user_id") @db.Uuid
  name               String                                 @db.VarChar(100)
  /// 대표 개업공인중개사 성명
  representativeName String                                 @map("representative_name") @db.VarChar(50)
  /// 중개사무소 등록번호. Unique only among live offices (see registrationKey).
  registrationNumber String                                 @map("registration_number") @db.VarChar(40)
  /// Uniqueness key of the 등록번호 (letters/digits/한글 only, upper-cased). GENERATED column
  /// (see migration 20261123160000_agencies_registration_key): never write it; read-only here.
  /// Unique among APPROVED / SUSPENDED, not deleted agencies only: partial unique index
  /// agencies_registration_key_live (migration 20261123190000_agencies_registration_key_live),
  /// which Prisma cannot express, so pending / rejected applications never reserve a number.
  registrationKey    String?                                @default(dbgenerated("upper(regexp_replace((registration_number)::text, '[^0-9A-Za-z가-힣]'::text, ''::text, 'g'::text))")) @map("registration_key") @db.VarChar(40)
  businessNumber     String?                                @map("business_number") @db.VarChar(20)
  phone              String                                 @db.VarChar(20)
  mobile             String?                                @db.VarChar(20)
  email              String?                                @db.VarChar(254)
  roadAddress        String                                 @map("road_address") @db.VarChar(200)
  jibunAddress       String?                                @map("jibun_address") @db.VarChar(200)
  addressDetail      String?                                @map("address_detail") @db.VarChar(100)
  zipCode            String?                                @map("zip_code") @db.VarChar(10)
  sggCode            String                                 @map("sgg_code") @db.VarChar(5)
  emdCode            String?                                @map("emd_code") @db.VarChar(10)
  lat                Float
  lng                Float
  location           Unsupported("geography(Point, 4326)")?
  intro              String?
  /// { mon: { open: "09:00", close: "18:00" }, ... }
  businessHours      Json?                                  @map("business_hours")
  specialties        AssetType[]                            @default([])
  logoMediaId        String?                                @map("logo_media_id") @db.Uuid
  /// Cover (header) image of the public page: PUBLIC media of purpose AGENCY_COVER.
  coverMediaId       String?                                @map("cover_media_id") @db.Uuid
  status             AgencyStatus                           @default(PENDING)
  statusReason       String?                                @map("status_reason") @db.VarChar(1000)
  approvedAt         DateTime?                              @map("approved_at") @db.Timestamptz(3)
  suspendedAt        DateTime?                              @map("suspended_at") @db.Timestamptz(3)
  /// Denormalized counters (maintained by services/jobs).
  activeListingCount Int                                    @default(0) @map("active_listing_count")
  viewCount          Int                                    @default(0) @map("view_count")
  warningCount       Int                                    @default(0) @map("warning_count")
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                              @map("deleted_at") @db.Timestamptz(3)

  owner           User                      @relation("AgencyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  logo            Media?                    @relation("AgencyLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  cover           Media?                    @relation("AgencyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  members         AgencyMember[]
  documents       AgencyDocument[]
  statusHistory   AgencyStatusHistory[]
  warnings        AgencyWarning[]
  listingAgencies ListingAgency[]
  primaryListings Listing[]                 @relation("ListingPrimaryAgency")
  dealTargets     DealRequestTarget[]
  proposals       Proposal[]
  contactGrants   DealRequestContactGrant[]
  banners         Banner[]
  reports         Report[]
  dailyStats      AgencyDailyStat[]
  site            AgencySite?
  subscriptions   AgencySubscription[]
  inquiries       Inquiry[]

  @@index([status, sggCode])
  @@index([emdCode, status])
  @@index([ownerUserId])
  @@index([location], type: Gist)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "agencies_name_trgm_idx")
  @@index([roadAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "agencies_road_address_trgm_idx")
  @@index([representativeName(ops: raw("gin_trgm_ops"))], type: Gin, map: "agencies_representative_name_trgm_idx")
  @@index([status, createdAt])
  @@index([logoMediaId])
  @@index([coverMediaId])
  @@index([registrationKey])
  @@map("agencies")
}

/// Staff of an agency (AGENT users) including the owner.
model AgencyMember {
  id            String             @id @default(uuid(7)) @db.Uuid
  agencyId      String             @map("agency_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  role          AgencyMemberRole   @default(AGENT)
  status        AgencyMemberStatus @default(ACTIVE)
  displayName   String             @map("display_name") @db.VarChar(50)
  title         String?            @db.VarChar(30)
  phone         String?            @db.VarChar(20)
  /// 소속공인중개사 여부 (false = 중개보조원)
  isLicensed    Boolean            @default(false) @map("is_licensed")
  licenseNumber String?            @map("license_number") @db.VarChar(40)
  joinedAt      DateTime           @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt     DateTime?          @map("removed_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency          Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingContacts ListingAgency[]
  proposals       Proposal[]

  @@unique([agencyId, userId])
  @@index([userId, status])
  @@map("agency_members")
}

/// Private documents (registration certificate etc.). Media is PRIVATE visibility.
model AgencyDocument {
  id           String             @id @default(uuid(7)) @db.Uuid
  agencyId     String             @map("agency_id") @db.Uuid
  type         AgencyDocumentType
  mediaId      String             @map("media_id") @db.Uuid
  uploadedById String?            @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  agency     Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  media      Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([agencyId, type])
  @@index([mediaId])
  @@map("agency_documents")
}

/// Admin decision history (approve/reject/suspend).
model AgencyStatusHistory {
  id               String        @id @default(uuid(7)) @db.Uuid
  agencyId         String        @map("agency_id") @db.Uuid
  fromStatus       AgencyStatus? @map("from_status")
  toStatus         AgencyStatus  @map("to_status")
  reason           String?       @db.VarChar(1000)
  decidedByAdminId String?       @map("decided_by_admin_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  decidedBy AdminUser? @relation(fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt(sort: Desc)])
  @@map("agency_status_history")
}

model AgencyWarning {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  reportId  String?  @map("report_id") @db.Uuid
  adminId   String?  @map("admin_id") @db.Uuid
  reason    String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  report Report?    @relation(fields: [reportId], references: [id], onDelete: SetNull)
  admin  AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt(sort: Desc)])
  @@map("agency_warnings")
}

/// Daily snapshot of an agency's cumulative listing views for the console dashboard chart: one row
/// per agency and KST day, upserted by the dashboard read and the hourly `agencies.daily-stats` job.
/// Views of day D = listingViews(D) − listingViews(D−1) (no row for D−1 → unknown, shown as 0).
model AgencyDailyStat {
  agencyId     String   @map("agency_id") @db.Uuid
  /// KST calendar day.
  day          DateTime @db.Date
  /// Sum of listings.view_count over the listings the agency actively (co-)brokers.
  listingViews Int      @default(0) @map("listing_views")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([agencyId, day])
  @@map("agency_daily_stats")
}

/// 사무소 홈페이지 at https://<slug>.<SITE_ROOT_DOMAIN>: one row per office, requested by the owner
/// (REQUESTED), decided by an admin (ACTIVE / REJECTED), later SUSPENDED / resumed.
/// Slug rules: @house/shared agencies/site.ts (also re-checked by deploy/sites.sh). The DB adds
/// CHECK constraints on the slug format (agency_sites_slug_format / _requested_slug_format) because
/// approved slugs flow into nginx server files and certbot names.
model AgencySite {
  id               String           @id @default(uuid(7)) @db.Uuid
  agencyId         String           @unique @map("agency_id") @db.Uuid
  status           AgencySiteStatus @default(REQUESTED)
  /// Approved slug (set on APPROVE; kept while ACTIVE / SUSPENDED). Unique among non-null values:
  /// partial unique index agency_sites_slug_key (SQL only, migration
  /// *_agencies_sites_subscriptions) — Prisma cannot express a partial index.
  slug             String?          @db.VarChar(30)
  /// Slug asked for (REQUESTED), or that of the last rejected request. At most one open
  /// (REQUESTED) request per slug: partial unique index agency_sites_requested_slug_open_key
  /// (SQL only) — a race maps to P2002 → AGENCY_SITE_SLUG_DUPLICATE.
  requestedSlug    String?          @map("requested_slug") @db.VarChar(30)
  /// AgencySiteColor key (shared AGENCY_SITE_COLORS); validated by the API, not a DB enum.
  color            String           @default("BLUE") @db.VarChar(20)
  /// 한 줄 소개
  tagline          String?          @db.VarChar(60)
  requestedAt      DateTime         @map("requested_at") @db.Timestamptz(3)
  decidedAt        DateTime?        @map("decided_at") @db.Timestamptz(3)
  decidedByAdminId String?          @map("decided_by_admin_id") @db.Uuid
  /// Reason of the last REJECT / SUSPEND (shown to the owner).
  decisionReason   String?          @map("decision_reason") @db.VarChar(500)
  /// Written by deploy/sites.sh once the per-slug certificate and nginx server are live; reset
  /// to null when an approval changes the slug.
  httpsReadyAt     DateTime?        @map("https_ready_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  decidedBy AdminUser? @relation("AgencySiteDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([requestedSlug])
  @@index([decidedByAdminId])
  @@map("agency_sites")
}

/// A paid period of an office product, recorded by an admin (offline bank transfer, SPEC O7).
/// startsOn / endsOn are inclusive KST days; endsOn null = open-ended. Cancel = canceledAt.
model AgencySubscription {
  id               String              @id @default(uuid(7)) @db.Uuid
  agencyId         String              @map("agency_id") @db.Uuid
  product          SubscriptionProduct
  startsOn         DateTime            @map("starts_on") @db.Date
  endsOn           DateTime?           @map("ends_on") @db.Date
  /// Amount received in 원 (not 만원); null = free / not recorded.
  amountWon        Int?                @map("amount_won")
  memo             String?             @db.VarChar(500)
  canceledAt       DateTime?           @map("canceled_at") @db.Timestamptz(3)
  createdByAdminId String?             @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation("AgencySubscriptionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([agencyId, product])
  @@index([createdByAdminId])
  @@map("agency_subscriptions")
}
