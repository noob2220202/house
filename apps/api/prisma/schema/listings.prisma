// Owned by the listings module team: property, listing (deal offer), co-brokerage, photos,
// 실매물 확인, favorites, recent views.

enum AssetType {
  APT
  OFFICETEL
  ONEROOM
  HOUSE
  COMMERCIAL
  LAND

  @@map("asset_type")
}

enum DealType {
  SALE
  JEONSE
  MONTHLY
  PRESALE

  @@map("deal_type")
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  CLOSED
  HIDDEN

  @@map("listing_status")
}

enum Direction {
  EAST
  WEST
  SOUTH
  NORTH
  SOUTH_EAST
  SOUTH_WEST
  NORTH_EAST
  NORTH_WEST

  @@map("direction")
}

enum DirectionBasis {
  LIVING_ROOM
  MAIN_ROOM
  ENTRANCE
  OTHER

  @@map("direction_basis")
}

enum FloorClass {
  LOW
  MID
  HIGH

  @@map("floor_class")
}

enum FloorDisplay {
  EXACT
  CLASS

  @@map("floor_display")
}

enum MoveInType {
  IMMEDIATE
  NEGOTIABLE
  DATE

  @@map("move_in_type")
}

enum VerificationMethod {
  OWNER_CONFIRMED
  DOCUMENT
  SITE_VISIT
  OWNER_CALL
  REGISTRY

  @@map("verification_method")
}

enum ListingOption {
  AIR_CONDITIONER
  REFRIGERATOR
  WASHER
  DRYER
  BED
  DESK
  CLOSET
  BUILT_IN_WARDROBE
  SHOE_RACK
  INDUCTION
  GAS_RANGE
  MICROWAVE
  DISHWASHER
  TV
  WIFI
  ELEVATOR
  PARKING
  PET_ALLOWED
  SECURITY
  CCTV
  VERANDA
  BALCONY

  @@map("listing_option")
}

enum ListingAgencyStatus {
  /// Co-broker request waiting for the primary agency's acceptance (not public, no rights).
  PENDING
  ACTIVE
  /// Left voluntarily (or cancelled its own request); may request again.
  WITHDRAWN
  /// Removed or rejected by the primary agency; cannot rejoin unless the primary reinstates it.
  REMOVED

  @@map("listing_agency_status")
}

/// 방 구성 (원룸·투룸 filter). Property: as stated; Listing: effective (stated, else from rooms).
enum RoomType {
  ONE_ROOM
  ONE_HALF_ROOM
  TWO_ROOM
  THREE_ROOM_PLUS

  @@map("room_type")
}

/// 용도지역 group of Property.zoning (shared landZoneOf).
enum LandZone {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  GREEN
  MANAGEMENT
  AGRICULTURAL
  CONSERVATION

  @@map("land_zone")
}

/// 지목 group of Property.landCategory (shared landCategoryOf).
enum LandCategory {
  DAE
  JEON
  DAP
  GWASUWON
  IMYA
  JAPJONGJI
  ETC

  @@map("land_category")
}

enum RecentViewTarget {
  LISTING
  COMPLEX
  AGENCY

  @@map("recent_view_target")
}

/// The physical unit. `ho` is PRIVATE and must never be serialized by public endpoints.
/// 건축물 용도 (건축법 시행령 별표1) — 표시·광고의 「중개대상물 종류」.
enum BuildingUse {
  DETACHED_HOUSE
  MULTI_UNIT_HOUSE
  MULTI_FAMILY_HOUSE
  OFFICIAL_RESIDENCE
  APARTMENT
  ROW_HOUSE
  MULTIPLEX_HOUSE
  DORMITORY
  NEIGHBORHOOD_FACILITY_1
  NEIGHBORHOOD_FACILITY_2
  CULTURE_ASSEMBLY
  RELIGIOUS
  SALES
  TRANSPORTATION
  MEDICAL
  EDUCATION_RESEARCH
  ELDERLY_CHILD
  TRAINING
  SPORTS
  OFFICE
  OFFICETEL
  LODGING
  AMUSEMENT
  FACTORY
  WAREHOUSE
  HAZARDOUS_MATERIAL
  AUTOMOBILE
  ANIMAL_PLANT
  RESOURCE_RECYCLING
  CORRECTIONAL_MILITARY
  BROADCASTING
  POWER_PLANT
  CEMETERY
  TOURIST_REST
  FUNERAL
  CAMPING

  @@map("building_use")
}

model Property {
  id             String                                 @id @default(uuid(7)) @db.Uuid
  assetType      AssetType                              @map("asset_type")
  complexId      String?                                @map("complex_id") @db.Uuid
  areaTypeId     String?                                @map("area_type_id") @db.Uuid
  roadAddress    String                                 @map("road_address") @db.VarChar(200)
  jibunAddress   String?                                @map("jibun_address") @db.VarChar(200)
  buildingName   String?                                @map("building_name") @db.VarChar(100)
  dong           String?                                @db.VarChar(20)
  ho             String?                                @db.VarChar(20)
  sggCode        String                                 @map("sgg_code") @db.VarChar(5)
  emdCode        String?                                @map("emd_code") @db.VarChar(10)
  lat            Float
  lng            Float
  location       Unsupported("geography(Point, 4326)")?
  /// Negative = basement (B1 = -1).
  floor          Int?
  totalFloors    Int?                                   @map("total_floors")
  /// 전용면적 ㎡
  exclusiveArea  Decimal?                               @map("exclusive_area") @db.Decimal(10, 2)
  /// 공급면적 ㎡
  supplyArea     Decimal?                               @map("supply_area") @db.Decimal(10, 2)
  /// 대지면적 (주택/토지) ㎡
  landArea       Decimal?                               @map("land_area") @db.Decimal(12, 2)
  /// 연면적 (주택/상업) ㎡
  totalFloorArea Decimal?                               @map("total_floor_area") @db.Decimal(12, 2)
  rooms          Int?
  /// 방 구성 as stated by the broker (only needed for 1.5룸; null = derived from rooms).
  roomType       RoomType?                              @map("room_type")
  baths          Int?
  direction      Direction?
  directionBasis DirectionBasis?                        @map("direction_basis")
  /// 사용승인일
  approvalDate   DateTime?                              @map("approval_date") @db.Date
  /// 주차대수 (총 / 세대당 표기는 서비스에서)
  parkingSpaces  Int?                                   @map("parking_spaces")
  heatingType    String?                                @map("heating_type") @db.VarChar(50)
  /// 용도지역 (토지/상업)
  zoning         String?                                @db.VarChar(50)
  /// 지목 (토지)
  landCategory   String?                                @map("land_category") @db.VarChar(20)
  /// 건축물 용도 (건축물대장). APT/OFFICETEL imply it when null.
  buildingUse    BuildingUse?                           @map("building_use")
  createdById    String?                                @map("created_by_id") @db.Uuid
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  complex   Complex?         @relation(fields: [complexId], references: [id], onDelete: SetNull)
  areaType  ComplexAreaType? @relation(fields: [areaTypeId], references: [id], onDelete: SetNull)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  listings  Listing[]

  @@index([complexId])
  @@index([sggCode, emdCode])
  @@index([location], type: Gist)
  @@index([roadAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "properties_road_address_trgm_idx")
  @@map("properties")
}

/// A deal offer on a property. Search columns (assetType…photoCount) are denormalized copies
/// maintained by ListingsService on every write so map/list queries hit one table.
model Listing {
  id                String          @id @default(uuid(7)) @db.Uuid
  /// 매물번호: sequential, human-friendly number (console, detail page, admin search).
  listingNo         Int             @unique @default(autoincrement()) @map("listing_no")
  propertyId        String          @map("property_id") @db.Uuid
  dealType          DealType        @map("deal_type")
  status            ListingStatus   @default(DRAFT)
  title             String?         @db.VarChar(80)
  description       String?
  /// 매매가 (만원)
  salePrice         Int?            @map("sale_price")
  /// 보증금 / 전세금 (만원)
  deposit           Int?
  /// 월세 (만원)
  monthlyRent       Int?            @map("monthly_rent")
  /// 분양가 (만원)
  presalePrice      Int?            @map("presale_price")
  /// 프리미엄 (만원, 마이너스 프리미엄 가능)
  premium           Int?
  /// 관리비 (원/월)
  maintenanceFeeWon Int?            @map("maintenance_fee_won")
  /// 관리비 부과방식 + 항목별 내역 (shared maintenanceFeeSchema: billingType, items[], unavailableReason)
  maintenanceFee    Json?           @map("maintenance_fee")
  moveInType        MoveInType?     @map("move_in_type")
  moveInDate        DateTime?       @map("move_in_date") @db.Date
  floorDisplay      FloorDisplay    @default(EXACT) @map("floor_display")
  options           ListingOption[] @default([])
  primaryAgencyId   String          @map("primary_agency_id") @db.Uuid
  createdById       String?         @map("created_by_id") @db.Uuid
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz(3)
  closedAt          DateTime?       @map("closed_at") @db.Timestamptz(3)
  expiresAt         DateTime?       @map("expires_at") @db.Timestamptz(3)
  hiddenReason      String?         @map("hidden_reason") @db.VarChar(500)
  /// Latest 실매물 확인 date.
  verifiedAt        DateTime?       @map("verified_at") @db.Timestamptz(3)
  viewCount         Int             @default(0) @map("view_count")
  favoriteCount     Int             @default(0) @map("favorite_count")
  /// Optimistic concurrency counter, bumped by every content/status write (not by counters).
  version           Int             @default(0)

  // --- denormalized search columns ---
  assetType     AssetType                              @map("asset_type")
  complexId     String?                                @map("complex_id") @db.Uuid
  sggCode       String                                 @map("sgg_code") @db.VarChar(5)
  emdCode       String?                                @map("emd_code") @db.VarChar(10)
  lat           Float
  lng           Float
  location      Unsupported("geography(Point, 4326)")?
  exclusiveArea Decimal?                               @map("exclusive_area") @db.Decimal(10, 2)
  rooms         Int?
  /// Effective 방 구성 (shared effectiveRoomType).
  roomType      RoomType?                              @map("room_type")
  /// 용도지역 / 지목 groups of the property's free-text values (shared landZoneOf / landCategoryOf).
  landZone      LandZone?                              @map("land_zone")
  landCategory  LandCategory?                          @map("land_category")
  baths         Int?
  direction     Direction?
  floorClass    FloorClass?                            @map("floor_class")
  builtYear     Int?                                   @map("built_year")
  /// Sort key in 만원: SALE=salePrice, PRESALE=presalePrice+premium, JEONSE/MONTHLY=deposit.
  priceSort     Int?                                   @map("price_sort")
  photoCount    Int                                    @default(0) @map("photo_count")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  primaryAgency Agency                @relation("ListingPrimaryAgency", fields: [primaryAgencyId], references: [id], onDelete: Restrict)
  complex       Complex?              @relation(fields: [complexId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  agencies      ListingAgency[]
  photos        ListingPhoto[]
  verifications ListingVerification[]
  favorites     FavoriteListing[]
  reports       Report[]
  proposals     ProposalListing[]

  @@index([status, dealType, assetType])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, priceSort])
  @@index([status, exclusiveArea])
  @@index([status, verifiedAt(sort: Desc)])
  @@index([status, builtYear(sort: Desc)])
  @@index([status, photoCount(sort: Desc)])
  @@index([status, expiresAt])
  @@index([complexId, status, dealType])
  @@index([primaryAgencyId, status])
  @@index([emdCode, status])
  @@index([propertyId])
  @@index([createdById])
  @@index([location], type: Gist)
  @@map("listings")
}

/// Co-brokerage: agencies advertising the same listing. Exactly one row has isPrimary=true and
/// matches Listing.primaryAgencyId (enforced in ListingsService inside a transaction).
model ListingAgency {
  id              String              @id @default(uuid(7)) @db.Uuid
  listingId       String              @map("listing_id") @db.Uuid
  agencyId        String              @map("agency_id") @db.Uuid
  isPrimary       Boolean             @default(false) @map("is_primary")
  status          ListingAgencyStatus @default(ACTIVE)
  contactMemberId String?             @map("contact_member_id") @db.Uuid
  contactName     String?             @map("contact_name") @db.VarChar(50)
  contactPhone    String?             @map("contact_phone") @db.VarChar(20)
  joinedAt        DateTime            @default(now()) @map("joined_at") @db.Timestamptz(3)
  withdrawnAt     DateTime?           @map("withdrawn_at") @db.Timestamptz(3)

  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  agency        Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  contactMember AgencyMember? @relation(fields: [contactMemberId], references: [id], onDelete: SetNull)

  @@unique([listingId, agencyId])
  @@index([agencyId, status])
  @@map("listing_agencies")
}

model ListingPhoto {
  id        String   @id @default(uuid(7)) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  caption   String?  @db.VarChar(100)
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([listingId, mediaId])
  @@index([listingId, sortOrder])
  @@index([mediaId])
  @@map("listing_photos")
}

/// 실매물 확인 record.
model ListingVerification {
  id                String             @id @default(uuid(7)) @db.Uuid
  listingId         String             @map("listing_id") @db.Uuid
  method            VerificationMethod
  verifiedAt        DateTime           @map("verified_at") @db.Timestamptz(3)
  verifiedByUserId  String?            @map("verified_by_user_id") @db.Uuid
  verifiedByAdminId String?            @map("verified_by_admin_id") @db.Uuid
  note              String?            @db.VarChar(500)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  listing         Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  verifiedByUser  User?      @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedByAdmin AdminUser? @relation(fields: [verifiedByAdminId], references: [id], onDelete: SetNull)

  @@index([listingId, verifiedAt(sort: Desc)])
  @@map("listing_verifications")
}

model FavoriteListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorite_listings")
}

/// Recent views (per user, upserted; capped by a cleanup job).
model RecentView {
  userId     String           @map("user_id") @db.Uuid
  targetType RecentViewTarget @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  viewedAt   DateTime         @default(now()) @map("viewed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetType, targetId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("recent_views")
}
