# e2e env for the auth module: its own database and Redis DB index so suites never collide.
DATABASE_URL=postgresql://house:house@localhost:5432/house_test_auth?schema=public
REDIS_DB=1
# Dummy OAuth clients so every provider is enabled; HTTP is faked (no network in tests).
KAKAO_CLIENT_ID=test-kakao-client
KAKAO_CLIENT_SECRET=test-kakao-secret
NAVER_CLIENT_ID=test-naver-client
NAVER_CLIENT_SECRET=test-naver-secret
GOOGLE_CLIENT_ID=test-google-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-secret
