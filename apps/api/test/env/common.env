# Shared by every e2e suite. Loaded first; test/env/<module>.env overrides it.
# Test-only dummy values (never real secrets).
NODE_ENV=test
HOST=127.0.0.1
PORT=4999
LOG_LEVEL=silent
LOG_PRETTY=false
SWAGGER_ENABLED=false
JOBS_ENABLED=false
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECRET=test-only-cookie-secret-0123456789abcdefghijkl
COOKIE_SECURE=false
# base64 of 32 bytes ("test-only-totp-key-32-bytes-long")
TOTP_ENCRYPTION_KEY=dGVzdC1vbmx5LXRvdHAta2V5LTMyLWJ5dGVzLWxvbmc=
REDIS_HOST_URL=redis://localhost:6379
REDIS_KEY_PREFIX=house-test:
THROTTLE_LIMIT=10000
REGION_SGG_CODE=46150
