{
  "name": "@house/api",
  "version": "0.0.0",
  "private": true,
  "description": "순천 부동산 플랫폼 API (NestJS)",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "node test/run-e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:test:prepare": "node test/prepare-test-dbs.mjs",
    "postinstall": "prisma generate",
    "db:migration:new": "node scripts/new-migration.mjs",
    "db:format": "node scripts/prisma-snake-map.mjs && prisma format"
  },
  "dependencies": {
    "@house/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.6",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "fast-xml-parser": "5.12.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@house/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
