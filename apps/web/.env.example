# apps/web — copy to .env.local for local development.

# API mock mode: the API client targets /mock-api/v1 (Next route handlers) instead of the backend.
NEXT_PUBLIC_API_MOCK=1

# Server-side base URL of the NestJS API (server components, rewrites). Browser always uses same-origin /api/v1.
INTERNAL_API_URL=http://127.0.0.1:4000
# Where /media/* is served from (defaults to INTERNAL_API_URL; nginx origin in production).
# MEDIA_ORIGIN=http://127.0.0.1:4000
# Extra absolute media hosts for next/image, comma separated.
# NEXT_PUBLIC_MEDIA_HOSTS=https://media.example.kr

# Public site origin (canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search console ownership tags (docs/DEPLOY.md "검색 등록"): the `content` value of the HTML tag each
# console shows. Empty → the <meta> tag is omitted.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Maps JS v3 (NCP) key id. Empty → the stylized StaticMapView fallback is used.
NEXT_PUBLIC_NAVER_MAP_KEY_ID=

# Per-agent build dir for parallel dev servers/builds (default .next).
# NEXT_DIST_DIR=.next-foundation

# 서비스 시군구 코드 (D1): 순천시 = 12150 (전남광주통합특별시). Comma separated, first = primary.
# Defaults to @house/shared DEFAULT_SGG_CODE ('12150') when unset.
# NEXT_PUBLIC_REGION_SGG_CODES=12150
