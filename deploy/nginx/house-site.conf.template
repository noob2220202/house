# Managed by /srv/house/bin/sites.sh (rendered from deploy/nginx/house-site.conf.template) and
# rewritten on every run — do not edit. 사무소 홈페이지 https://{{SITE_SLUG}}.{{DOMAIN}}: the user site
# (the web app maps the host to the office's pages) with this office's own certificate.
# Static certificate paths on purpose: the root master process reads them on reload (an
# ssl_certificate variable would be read by the www-data workers, which cannot open privkey.pem).
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{SITE_SLUG}}.{{DOMAIN}};
    ssl_certificate /etc/letsencrypt/live/house-site-{{SITE_SLUG}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/house-site-{{SITE_SLUG}}/privkey.pem;
    include /etc/nginx/snippets/house-tls-params.conf;
    include /etc/nginx/snippets/house-server-common.conf;
    include /etc/nginx/snippets/house-web-locations.conf;
    access_log /var/log/nginx/house-sites.access.log;
    error_log /var/log/nginx/house-sites.error.log warn;
}
