# Rendered to /etc/nginx/snippets/house-web-locations.conf. User site (apex domain).
include /etc/nginx/snippets/house-csp.conf;

# Regex locations are case-insensitive (~*) on purpose: Express routes ignore letter case, so a
# case-sensitive prefix such as /api/v1/admin/ could be bypassed with /api/v1/ADMIN/. They are
# checked before the plain /api/ prefix below, and the first matching regex wins. "/+" also
# catches repeated slashes should merge_slashes ever be turned off.

# Admin API is only reachable through the admin subdomain (defense in depth; the API also
# requires an admin session + TOTP and optionally ADMIN_IP_ALLOWLIST).
location ~* ^/+api/+v1/+admin(?:/|$) {
    return 404;
}

# Strict per-IP limit only for the login flows themselves (OAuth start/callback, signup).
# Frequent reads (/auth/me, /auth/csrf, /auth/providers, /auth/sessions) use the /api/ zone:
# many mobile users share one carrier (CGNAT) address.
location ~* ^/+api/+v1/+auth/+(?:oauth/|signup) {
    limit_req zone=house_auth burst=30 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_api;
}

location /api/ {
    limit_req zone=house_api burst=100 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_api;
}

include /etc/nginx/snippets/house-media.conf;

# Next.js build assets (content-hashed names) straight from the active release: no Node event
# loop time, nginx gzip, cached for a year, no rate limit. A file the active release does not
# have (a page rendered by a not-yet-reloaded worker during a deploy) is asked from Next itself.
location ^~ /_next/static/ {
    alias {{CURRENT}}/apps/web/.next/static/;
    try_files $uri @house_web;
    include /etc/nginx/snippets/house-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    gzip_static on;
    access_log off;
    log_not_found off;
}

# Image optimizer (resizes /media/* on demand; results are cached on disk by Next). A page with
# many listing cards loads dozens at once, so the burst is large.
location ^~ /_next/image {
    limit_req zone=house_images burst=200 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_web;
}

# Pages and RSC/prefetch requests. Each uncached render costs SSR CPU and API calls, so one
# client (a scraper walking /listing/<id>) is capped; normal browsing, link prefetching and
# CGNAT-shared addresses stay far below the burst.
location / {
    limit_req zone=house_pages burst=80 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_web;
}

location @house_web {
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_web;
}
