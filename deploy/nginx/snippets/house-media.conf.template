# Rendered to /etc/nginx/snippets/house-media.conf. Public media (UPLOAD_DIR) at /media/*.
# Only image files with API-generated key syntax are served; anything else (html, svg, js, temp
# files, directory listings) is a 404, and responses are sandboxed, so nothing here can execute.
# Private documents live in a sibling directory that nginx never maps.
location ~ "^/media/([a-z0-9][a-z0-9/_.-]*\.(?:webp|avif|jpe?g|png|gif))$" {
    alias {{UPLOAD_PUBLIC}}/$1;
    limit_except GET { deny all; }
    types {
        image/webp webp;
        image/avif avif;
        image/jpeg jpg jpeg;
        image/png png;
        image/gif gif;
    }
    default_type application/octet-stream;
    include /etc/nginx/snippets/house-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox" always;
    add_header Cross-Origin-Resource-Policy "same-site" always;
    access_log off;
    log_not_found off;
    etag on;
}

location /media/ {
    return 404;
}
