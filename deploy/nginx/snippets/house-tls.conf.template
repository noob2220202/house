# Rendered to /etc/nginx/snippets/house-tls.conf. One Let's Encrypt certificate covers
# {{DOMAIN}}, www.{{DOMAIN}} and {{ADMIN_DOMAIN}} (certbot --cert-name {{CERT_NAME}}).
# Mozilla "intermediate" profile. (Let's Encrypt no longer runs OCSP, so no stapling.)
ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:house_ssl:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;
