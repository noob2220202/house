# Rendered to /etc/nginx/snippets/house-tls.conf. One Let's Encrypt certificate covers
# {{DOMAIN}}, www.{{DOMAIN}} and {{ADMIN_DOMAIN}} (certbot --cert-name {{CERT_NAME}}).
# Protocols, ciphers and the session cache are in house-tls-params.conf, which the office sites
# (/etc/nginx/house/sites/*.conf, one certificate per office) include with their own certificate.
ssl_certificate /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
include /etc/nginx/snippets/house-tls-params.conf;
