# Rendered to /etc/nginx/snippets/house-admin-locations.conf. Back-office (admin subdomain).
include /etc/nginx/snippets/house-csp.conf;
# Optional IP allow-list (edit /etc/nginx/house/admin-allowlist.conf, then: nginx -t && reload).
# Included at server level, so it covers every location below (API, pages, static files, media).
include /etc/nginx/house/admin-allowlist.conf;
add_header X-Robots-Tag "noindex, nofollow" always;

# Case-insensitive regexes with "/+" (see house-web-locations.conf): Express routes ignore
# letter case. Strict per-IP limit only for credential endpoints (password login, TOTP,
# password change); /api/v1/admin/auth/me and /csrf are ordinary reads in the /api/ zone.
location ~* ^/+api/+v1/+admin/+auth/+(?:login|totp/|password) {
    limit_req zone=house_auth burst=20 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_api;
}

# The user login flows are reachable here too; keep them under the same strict limit.
location ~* ^/+api/+v1/+auth/+(?:oauth/|signup) {
    limit_req zone=house_auth burst=30 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_api;
}

location /api/ {
    limit_req zone=house_api burst=100 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_api;
}

include /etc/nginx/snippets/house-media.conf;

# Build assets from the active release (see house-web-locations.conf).
location ^~ /_next/static/ {
    alias {{CURRENT}}/apps/admin/.next/static/;
    try_files $uri @house_admin;
    include /etc/nginx/snippets/house-security-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
    gzip_static on;
    access_log off;
    log_not_found off;
}

location ^~ /_next/image {
    limit_req zone=house_images burst=200 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_admin;
}

location / {
    limit_req zone=house_pages burst=80 nodelay;
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_admin;
}

location @house_admin {
    include /etc/nginx/snippets/house-proxy.conf;
    proxy_pass http://house_admin;
}
