# Rendered to /etc/nginx/snippets/house-security-headers.conf. Included at server level and again
# in every location that has its own add_header (nginx does not merge add_header across levels).
{{HSTS_LINE}}
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# No interest-cohort=(): FLoC is gone and browsers log "Unrecognized feature" for it.
add_header Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)" always;
